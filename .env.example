# PulseWatch Production Environment Variables Example
# Copy to .env and configure secrets before deployment

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pulsewatch
DB_USER=pulsewatch
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_ROOT_PASSWORD=YOUR_STRONG_ROOT_PASSWORD_HERE

# Redis Distributed Cache & Lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_OPTIONAL_REDIS_PASSWORD

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# SMTP Email Delivery (SendGrid, AWS SES, Mailgun, or standard SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY_HERE

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=https://pulsewatch.yourdomain.com,http://localhost:8080
